# Backend local
# Copia este archivo a .env y ajusta los valores si quieres conectar con un HA real.
ENERGYHUB_DATA_DIR=./data
ENERGYHUB_DEMO=1
ENERGYHUB_DEV=1
ENERGYHUB_LOG_LEVEL=info

# Opcional: Home Assistant fuera del add-on
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=tu_token_de_larga_duracion

# Opcional: cambiar la API de Pepe (tests o espejo)
# ENERGYHUB_PEPE_API_URL=https://shared-api.pepeenergy.com/prices/electricity/last-month
